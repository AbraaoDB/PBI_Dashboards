table fCartoes
	lineageTag: b9dc7e94-e890-4d53-927a-7c1b9f51658b

	column PartidaId
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 8ec2feca-f50d-4dbb-bd09-b2295cd0af17
		summarizeBy: none
		sourceColumn: PartidaId

	column Clube
		dataType: string
		isHidden
		lineageTag: 30bb0769-c9ea-492c-b579-b0995d7b1428
		summarizeBy: none
		sourceColumn: Clube

	column Cartao
		dataType: string
		lineageTag: 32333354-fc48-4a6d-8f2c-9a37cc5cb22a
		summarizeBy: none
		sourceColumn: Cartao

	column Atleta
		dataType: string
		lineageTag: 3afa11c3-2fde-407a-ae93-0f1ee355fa29
		summarizeBy: none
		sourceColumn: Atleta

	column NumeroCamisa
		dataType: int64
		formatString: 0
		lineageTag: c549cbc2-60fd-4c9e-b768-7b878b24055d
		summarizeBy: none
