	column MinutoTexto
		dataType: string
		lineageTag: 3addcf93-cd1c-40fe-b6f2-fe41d9c1cf32
		summarizeBy: none
		sourceColumn: MinutoTexto

	column Acrescimo
		dataType: int64
		formatString: 0
		lineageTag: a2e69657-71e3-4f2b-8c88-7e5b5282275d
		summarizeBy: none
		sourceColumn: Acrescimo

	column Data
		dataType: dateTime
		isHidden
		formatString: dd/MM/yyyy
		lineageTag: e1a91091-1a4d-4d11-b995-98dd9d3dc289
		summarizeBy: none
		sourceColumn: Data

		annotation UnderlyingDateTimeDataType = Date

	partition fCartoes = m
		mode: import
		queryGroup: Fatos
		source =
				let
				    Fonte = fxLerCsv("campeonato-brasileiro-cartoes.csv"),
				    ColunasRenomeadas = Table.RenameColumns(Fonte, {
				        {"partida_id", "PartidaId"}, {"clube", "Clube"}, {"cartao", "Cartao"},
				        {"atleta", "Atleta"}, {"num_camisa", "NumeroCamisa"}, {"posicao", "Posicao"}, {"minuto", "MinutoTexto"}
				    }),
				    // Rodada já está em dPartida
				    RodadaRemovida = Table.RemoveColumns(ColunasRenomeadas, {"rodata"}),
				    VaziosComoNulo = Table.ReplaceValue(RodadaRemovida, "", null, Replacer.ReplaceValue,
				        {"Atleta", "NumeroCamisa", "Posicao"}),
				    // Fonte grafa "Zagueira" em 22 linhas: mesma posição
				    PosicaoPadronizada = Table.ReplaceValue(VaziosComoNulo, "Zagueira", "Zagueiro", Replacer.ReplaceValue, {"Posicao"}),
				    TiposDefinidos = Table.TransformColumnTypes(PosicaoPadronizada, {
				        {"PartidaId", Int64.Type}, {"Clube", type text}, {"Cartao", type text},
				        {"Atleta", type text}, {"NumeroCamisa", Int64.Type}, {"Posicao", type text}, {"MinutoTexto", type text}
				    }, "pt-BR"),
				    // "90+3" = minuto 90 com 3 de acréscimo
				    MinutoAdicionado = Table.AddColumn(TiposDefinidos, "Minuto",
				        each Number.From(Text.Split([MinutoTexto], "+"){0}), Int64.Type),
				    AcrescimoAdicionado = Table.AddColumn(MinutoAdicionado, "Acrescimo",
				        each Number.From(Text.Split([MinutoTexto], "+"){1}? ?? "0"), Int64.Type),
				    // Data da partida para ligar o fato direto ao calendário
				    PartidaMesclada = Table.NestedJoin(AcrescimoAdicionado, {"PartidaId"},
				        stgPartidas, {"PartidaId"}, "Partida", JoinKind.LeftOuter),
				    DataExpandida = Table.ExpandTableColumn(PartidaMesclada, "Partida", {"Data"}),
				    DataTipada = Table.TransformColumnTypes(DataExpandida, {{"Data", type date}})
				in
				    DataTipada

