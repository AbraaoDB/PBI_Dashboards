model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parâmetros

	annotation PBI_QueryGroupOrder = 0

queryGroup Funções

	annotation PBI_QueryGroupOrder = 1

queryGroup Staging

queryGroup Fatos

	annotation PBI_QueryGroupOrder = 2

queryGroup Dimensões

	annotation PBI_QueryGroupOrder = 3

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["caminhoPasta","fxLerCsv","fxTemporada","stgPartidas","stgEstatisticas","fDesempenho","fGols","fCartoes","dPartida","dClube","dCalendario"]

annotation PBI_ProTooling = ["DevMode"]

ref table fDesempenho
ref table fGols
ref table fCartoes
ref table dPartida
ref table dClube
ref table dCalendario

ref cultureInfo pt-BR

