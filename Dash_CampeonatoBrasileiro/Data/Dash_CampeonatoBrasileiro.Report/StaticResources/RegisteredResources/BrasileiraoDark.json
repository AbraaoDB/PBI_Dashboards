{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.153.json",
  "name": "BrasileiraoDark.json",
  "dataColors": [
    "#22D3EE",
    "#60A5FA",
    "#F59E0B",
    "#34D399",
    "#F87171",
    "#A78BFA",
    "#64748B",
    "#8FA3BF"
  ],
  "background": "#060B16",
  "foreground": "#E6EDF7",
  "tableAccent": "#22D3EE",
  "good": "#34D399",
  "neutral": "#FBBF24",
  "bad": "#F87171",
  "maximum": "#22D3EE",
  "center": "#1C2940",
  "minimum": "#0D1628",
  "null": "#1C2940",
  "firstLevelElements": "#E6EDF7",
  "secondLevelElements": "#8FA3BF",
  "thirdLevelElements": "#1C2940",
  "fourthLevelElements": "#64748B",
  "secondaryBackground": "#0D1628",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#E6EDF7"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#E6EDF7"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#E6EDF7"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#8FA3BF"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0D1628"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1C2940"
              }
            },
            "radius": 16
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 16,
            "bottom": 16,
            "left": 20,
            "right": 20
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#E6EDF7"
              }
            }
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#8FA3BF"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#8FA3BF"
              }
            },
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#1C2940"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "start": 0,
            "labelColor": {
              "solid": {
                "color": "#8FA3BF"
              }
            },
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#1C2940"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#8FA3BF"
              }
            },
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#8FA3BF"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#060B16"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#060B16"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "shape": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#8FA3BF"
              }
            }
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#E6EDF7"
              }
            },
            "background": {
              "solid": {
                "color": "#0D1628"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit",
            "fontColor": {
              "solid": {
                "color": "#8FA3BF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0D1628"
              }
            }
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#E6EDF7"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E6EDF7"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#0D1628"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#111C31"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "showMarker": false,
            "strokeWidth": 3
          }
        ],
        "labels": [
          {
            "show": false
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "labels": [
          {
            "show": true
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "gridlineShow": false
          }
        ]
      }
    }
  }
}