{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.140.json",
  "name": "NovaDarkTheme.json",
  "dataColors": [
    "#7C5CFF",
    "#22D3EE",
    "#A855F7",
    "#34D399",
    "#F472B6",
    "#FBBF24",
    "#60A5FA",
    "#F87171"
  ],
  "foreground": "#F4F3FA",
  "foregroundNeutralSecondary": "#9A96B8",
  "foregroundNeutralTertiary": "#6B678A",
  "background": "#1A1727",
  "backgroundLight": "#211D31",
  "backgroundNeutral": "#2A2740",
  "secondaryBackground": "#0D0B16",
  "tableAccent": "#7C5CFF",
  "good": "#34D399",
  "neutral": "#FBBF24",
  "bad": "#F87171",
  "maximum": "#7C5CFF",
  "center": "#4B4570",
  "minimum": "#211D31",
  "null": "#2A2740",
  "hyperlink": "#A78BFA",
  "visitedHyperlink": "#C4B5FD",
  "textClasses": {
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#F4F3FA"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#9A96B8"
    },
    "callout": {
      "fontSize": 26,
      "fontFace": "wf_standard-font, helvetica, arial, sans-serif",
      "color": "#F4F3FA"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#F4F3FA"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1A1727"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#2A2740"
              }
            },
            "radius": 10,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#F4F3FA"
              }
            },
            "background": {
              "solid": {
                "color": "#1A1727"
              }
            },
            "fontSize": 13,
            "bold": true,
            "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
            "alignment": "left",
            "titleWrap": true
          }
        ],
        "subTitle": [
          {
            "show": false,
            "fontColor": {
              "solid": {
                "color": "#9A96B8"
              }
            },
            "fontSize": 9
          }
        ],
        "padding": [
          {
            "top": 14,
            "bottom": 16,
            "left": 16,
            "right": 16
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#9A96B8"
              }
            },
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "start": 0,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#9A96B8"
              }
            },
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#272340"
              }
            },
            "gridlineStyle": "dotted",
            "gridlineThickness": 1
          }
        ],
        "labels": [
          {
            "show": false,
            "fontSize": 9,
            "color": {
              "solid": {
                "color": "#9A96B8"
              }
            }
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontSize": 9,
            "labelColor": {
              "solid": {
                "color": "#9A96B8"
              }
            },
            "showTitle": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "image": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "value": [
          {
            "$id": "default",
            "fontSize": 26,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#F4F3FA"
              }
            },
            "fontFamily": "wf_standard-font, helvetica, arial, sans-serif"
          }
        ],
        "label": [
          {
            "$id": "default",
            "show": true,
            "fontSize": 11,
            "bold": false,
            "fontColor": {
              "solid": {
                "color": "#9A96B8"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#211D31"
              }
            }
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#2A2740"
              }
            },
            "radius": 8
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#9A96B8"
              }
            },
            "background": {
              "solid": {
                "color": "#211D31"
              }
            },
            "textSize": 10
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#F4F3FA"
              }
            },
            "background": {
              "solid": {
                "color": "#211D31"
              }
            },
            "textSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1A1727"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#9A96B8"
              }
            },
            "backColor": {
              "solid": {
                "color": "#211D31"
              }
            },
            "fontSize": 10,
            "bold": true,
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit",
            "alignment": "Left"
          }
        ],
        "values": [
          {
            "fontSize": 10,
            "fontColorPrimary": {
              "solid": {
                "color": "#F4F3FA"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#F4F3FA"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#1A1727"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#1E1A2D"
              }
            }
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#272340"
              }
            },
            "rowPadding": 4,
            "outlineColor": {
              "solid": {
                "color": "#2A2740"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#F4F3FA"
              }
            },
            "backColor": {
              "solid": {
                "color": "#211D31"
              }
            },
            "bold": true
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#9A96B8"
              }
            },
            "backColor": {
              "solid": {
                "color": "#211D31"
              }
            },
            "fontSize": 10,
            "bold": true
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#F4F3FA"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1A1727"
              }
            },
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontSize": 10,
            "fontColorPrimary": {
              "solid": {
                "color": "#F4F3FA"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#F4F3FA"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#1A1727"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#1E1A2D"
              }
            }
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#272340"
              }
            },
            "rowPadding": 4
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0D0B16"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#08070F"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}