		sourceColumn: product_rating

		annotation SummarizationSetBy = Automatic

	/// Chave surrogada inteira. Lado 1 do relacionamento com fOrderItems.
	column ProdutoSK
		dataType: int64
		isHidden
		isKey
		formatString: 0
		isAvailableInMdx: false
