/// KPIs pré-calculados do CSV de estatísticas. Fora do modelo de propósito: são um
/// snapshot congelado e divergem das medidas. Serve só para conferir a carga.
expression statsCargaCsv =
		let
		    // QuoteStyle.Csv é obrigatório aqui: "$177,134,263.74" é um campo único entre aspas
		    Fonte = Csv.Document(File.Contents(caminhoDados & "dataset-statistics.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		    #"Cabeçalhos Promovidos" = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
		    // Remove "$" e separador de milhar antes de converter para número
		    #"Moeda Limpa" = Table.TransformColumns(#"Cabeçalhos Promovidos", {
		        {"Total Revenue", each Number.FromText(Text.Remove(_, {"$", ","}), "en-US"), Currency.Type},
		        {"Total Profit", each Number.FromText(Text.Remove(_, {"$", ","}), "en-US"), Currency.Type},
		        {"Average Order Value", each Number.FromText(Text.Remove(_, {"$", ","}), "en-US"), Currency.Type}
		    }),
		    #"Tipos Ajustados" = Table.TransformColumnTypes(#"Moeda Limpa", {{"Total Transactions", Int64.Type}, {"Total Columns", Int64.Type}, {"Total Customers", Int64.Type}, {"Total Products Used", Int64.Type}, {"Date Range", type text}, {"Average Rating", type number}, {"Return Rate", Percentage.Type}, {"Cancellation Rate", Percentage.Type}}, "en-US")
		in
		    #"Tipos Ajustados"
	lineageTag: da01de33-cbfd-4496-b912-ee09dec6715c

	annotation PBI_ResultType = Table

/// Conferência de carga: linhas e nulos nas colunas críticas de cada staging.
/// Não carrega no modelo — visualize no editor do Power Query após um refresh.
expression qaValidacaoCarga =
		let
		    __fxContaNulos = (nome as text, tabela as table, colunas as list) as table =>
		        Table.FromRecords(
		            List.Transform(
		                colunas,
		                (coluna) =>
		                    [
		                        Tabela = nome,
		                        Coluna = coluna,
		                        Linhas = Table.RowCount(tabela),
		                        Nulos = List.Count(List.Select(Table.Column(tabela, coluna), (valor) => valor = null))
		                    ]
		            )
		        ),
		    // Nulos esperados: delivery_days e customer_rating só existem em pedido concluído
		    Resultado = Table.Combine({
		        __fxContaNulos("fOrders", srcEcommerceSales, {"order_id", "order_date", "customer_id", "delivery_days", "customer_rating"}),
		        __fxContaNulos("fOrderItems", srcOrderItems, {"order_id", "product_id", "net_sales", "profit", "quantity"}),
		        __fxContaNulos("dCliente", srcCustomerMaster, {"customer_id", "customer_acquisition_cost"}),
		        __fxContaNulos("dProduto", srcProductCatalog, {"product_id", "unit_price"})
		    }),
		    Tipada = Table.TransformColumnTypes(Resultado, {{"Tabela", type text}, {"Coluna", type text}, {"Linhas", Int64.Type}, {"Nulos", Int64.Type}})
		in
		    Tipada
	lineageTag: 57268b46-3223-43e9-85d0-285d9146d0f7

	annotation PBI_ResultType = Table

