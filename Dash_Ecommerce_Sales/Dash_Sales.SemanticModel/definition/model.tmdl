model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["caminhoDados","fxGeraCalendario","srcEcommerceSales","srcOrderItems","srcCustomerMaster","srcProductCatalog","statsCargaCsv","qaValidacaoCarga","dCalendario","dCliente","dProduto","fOrders","fOrderItems"]

annotation PBI_ProTooling = ["DevMode"]

ref table dCalendario
ref table dCliente
ref table dProduto
ref table fOrders
ref table fOrderItems
ref table Medidas

ref cultureInfo pt-BR

