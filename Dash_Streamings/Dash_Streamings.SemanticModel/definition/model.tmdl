model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["caminhoDados","fStreamingCatalog","dPlatform","dGenre","dCountry","dType","dRating"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table fStreamingCatalog
ref table dCalendario
ref table dPlatform
ref table dGenre
ref table dCountry
ref table dType
ref table dRating
ref table Medidas

ref cultureInfo pt-BR

