	/// Cor de identidade da plataforma no contexto (dimensão ou linha do fato).
	measure 'Cor Plataforma' =
			VAR __p =
			    COALESCE ( SELECTEDVALUE ( dPlatform[Platform] ), SELECTEDVALUE ( fStreamingCatalog[platform] ) )
			RETURN
			    SWITCH (
			        __p,
			        "Netflix", "#E50914",
			        "Amazon Prime Video", "#00A8E1",
			        "Disney+", "#4F7CFF",
			        "Hulu", "#1CE783",
			        "HBO Max", "#A259FF",
			        "Paramount+", "#2DD4BF",
			        "Apple TV+", "#D4D4DC",
			        "Peacock", "#FACC15",
			        "JioCinema", "#EC4899",
			        "Crunchyroll", "#FF7A1A",
			        [Cor Primária]
			    )
		displayFolder: 91. Cores
		lineageTag: e20ce9ba-b72b-4873-bb89-d1bc9f546809

	/// Nome curto da plataforma para espaços estreitos.
	measure 'Plataforma Rótulo' =
			VAR __p =
			    COALESCE ( SELECTEDVALUE ( dPlatform[Platform] ), SELECTEDVALUE ( fStreamingCatalog[platform] ) )
			RETURN
			    IF ( __p = "Amazon Prime Video", "Prime Video", __p )
		displayFolder: 99. Técnicas
		lineageTag: 4f539606-0458-4f24-889f-2959dac433ce

	/// Títulos com ao menos um prêmio.
	measure 'Títulos Premiados' = CALCULATE ( [Total de Títulos], KEEPFILTERS ( fStreamingCatalog[awards_won] > 0 ) )
		formatString: #,0
		displayFolder: 05. Reconhecimento
		lineageTag: dd7a8ac2-f712-452c-bbe9-d4095c512ea1

	/// Fração de títulos com ao menos um prêmio.
	measure '% Títulos Premiados' = DIVIDE ( [Títulos Premiados], [Total de Títulos] )
		formatString: 0.0%
		displayFolder: 05. Reconhecimento
		lineageTag: 43b6fb7d-7f23-468a-a138-2d147ca0bb98

	/// Taxa de premiação: prêmios ganhos a cada 100 títulos.
	measure 'Prêmios por 100 Títulos' = DIVIDE ( [Prêmios Ganhos], [Total de Títulos] ) * 100
		formatString: 0.0
		displayFolder: 05. Reconhecimento
		lineageTag: a9a9be8e-0bb6-4803-86db-df2a973fa4cf

	/// Horas assistidas médias por título, em milhões.
	measure 'Horas Médias por Título (Mi)' = AVERAGE ( fStreamingCatalog[hours_watched_million] )
		formatString: #,0.0
		displayFolder: 03. Engajamento
		lineageTag: a5da6a3b-c006-434d-9fc7-6b078225bceb

	/// Fração do catálogo produzida fora dos Estados Unidos.
	measure '% Títulos Fora dos EUA' =
			DIVIDE (
			    CALCULATE ( [Total de Títulos], KEEPFILTERS ( fStreamingCatalog[country] <> "United States" ) ),
			    [Total de Títulos]
			)
		formatString: 0.0%
		displayFolder: 01. Volume
		lineageTag: 05887298-785e-464a-9f6c-c504e8ab341f

	/// Descrição textual dos filtros ativos (plataforma, tipo, gênero e período).
	measure 'Contexto Recorte Texto' =
			VAR __nP = COUNTROWS ( VALUES ( dPlatform[Platform] ) )
			VAR __P =
			    IF (
			        NOT ISFILTERED ( dPlatform[Platform] ), "Todas as plataformas",
			        IF ( __nP <= 2, CONCATENATEX ( VALUES ( dPlatform[Platform] ), dPlatform[Platform], " + " ), __nP & " plataformas" )
			    )
			VAR __T =
			    IF (
			        ISFILTERED ( dType[Tipo] ) && COUNTROWS ( VALUES ( dType[Tipo] ) ) = 1,
			        IF ( SELECTEDVALUE ( dType[Tipo] ) = "Movie", "Filmes", "Séries" ),
			        "Filmes e séries"
			    )
			VAR __nG = COUNTROWS ( VALUES ( dGenre[Genero] ) )
			VAR __G =
			    IF ( ISFILTERED ( dGenre[Genero] ), " · " & IF ( __nG = 1, SELECTEDVALUE ( dGenre[Genero] ), __nG & " gêneros" ) )
			VAR __A0 = YEAR ( MIN ( fStreamingCatalog[date_added] ) )
			VAR __A1 = YEAR ( MAX ( fStreamingCatalog[date_added] ) )
			VAR __A = IF ( ISBLANK ( __A0 ), "sem dados", IF ( __A0 = __A1, FORMAT ( __A0, "0" ), __A0 & "–" & __A1 ) )
			RETURN
			    __P & " · " & __T & __G & " · " & __A
		displayFolder: 99. Técnicas
		lineageTag: ac77c253-c61a-4c3a-8bed-8edf2f39d8b9

	/// Folha de estilo comum a todos os blocos HTML (tokens interpolados).
	measure 'CSS Base HTML' =
			VAR __Css =
			    "<style>html,body{margin:0;padding:0;background:transparent;overflow:hidden}*{box-sizing:border-box}"
			    & "body,#htmlViewer,#htmlContent,.htmlViewerEntry,.r,.cd,.pc,.er,.cr{font-family:'Segoe UI',system-ui,sans-serif;color:%TX%;font-size:13px;line-height:1.35;-webkit-font-smoothing:antialiased}"
			    & ".r{width:100%;height:100vh;position:relative}"
			    & ".cd{height:100vh;border-radius:18px;padding:20px 24px;background:linear-gradient(160deg,%CARD2% 0%,%CARD% 62%);border:1px solid %LINE%;box-shadow:inset 0 1px 0 #FFFFFF0D;position:relative;overflow:hidden}"
			    & ".hdr{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}"
			    & ".ey{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:%TX2%;font-weight:600}"
			    & ".tt{font-size:18px;font-weight:600;margin-top:3px;letter-spacing:-.01em}"
			    & ".sb{font-size:13px;color:%TX2%;margin-top:3px}.sb b{color:%TX%;font-weight:600}"
			    & ".nm{font-variant-numeric:tabular-nums}"
			    & ".pos{color:%POS%}.neg{color:%NEG%}.warn{color:%WARN%}.mut{color:%TX2%}"
			    & ".chip{display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border-radius:999px;font-size:12px;font-weight:600;background:%LINE%;color:%TX%;white-space:nowrap}"
			    & ".chip.pos{background:%POS%1F;color:%POS%}.chip.neg{background:%NEG%1F;color:%NEG%}.chip.pri{background:%PRI%2E;color:%PRI3%}"
			    & ".dot{width:8px;height:8px;border-radius:50%;display:inline-block;flex:none}"
			    & ".bar{height:8px;border-radius:99px;background:%LINE%;overflow:hidden}"
			    & ".bar i{display:block;height:100%;border-radius:99px;transform-origin:left;animation:gx .9s cubic-bezier(.2,.7,.2,1) both}"
			    & "@keyframes gx{from{transform:scaleX(0)}to{transform:scaleX(1)}}"
			    & "@keyframes gy{from{transform:scaleY(0)}to{transform:scaleY(1)}}"
			    & "@keyframes fu{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}"
			    & ".fu{animation:fu .6s ease-out both}"
			    & ".glow{position:absolute;border-radius:50%;filter:blur(70px);pointer-events:none}"
			    & ".tip{position:relative}"
			    & ".tp{position:absolute;left:50%;bottom:calc(100% + 8px);transform:translateX(-50%);background:%BG%F2;border:1px solid %LINE%;border-radius:10px;padding:8px 11px;font-size:12px;line-height:1.55;color:%TX2%;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .15s;z-index:30;box-shadow:0 10px 30px #000000A6}"
			    & ".tp b{color:%TX%}.tp.dn{bottom:auto;top:calc(100% + 8px)}.tp.lf{left:auto;right:0;transform:none}.tp.rt{left:0;transform:none}"
			    & ".tip:hover .tp{opacity:1}"
			    & ".vazio{height:100vh;display:grid;place-items:center;color:%TX2%;font-size:14px;text-align:center}"
			    & "@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}</style>"
			VAR __1 = SUBSTITUTE ( __Css, "%TX2%", [Cor Texto Suave] )
			VAR __2 = SUBSTITUTE ( __1, "%TX%", [Cor Texto] )
			VAR __3 = SUBSTITUTE ( __2, "%CARD2%", [Cor Fundo Card Elevado] )
			VAR __4 = SUBSTITUTE ( __3, "%CARD%", [Cor Fundo Card] )
			VAR __5 = SUBSTITUTE ( __4, "%LINE%", [Cor Trilho] )
			VAR __6 = SUBSTITUTE ( __5, "%POS%", [Cor Positiva] )
			VAR __7 = SUBSTITUTE ( __6, "%NEG%", [Cor Negativa] )
			VAR __8 = SUBSTITUTE ( __7, "%WARN%", [Cor Alerta] )
			VAR __9 = SUBSTITUTE ( __8, "%PRI3%", [Cor Destaque Suave] )
			VAR __10 = SUBSTITUTE ( __9, "%PRI%", [Cor Primária] )
			RETURN
			    SUBSTITUTE ( __10, "%BG%", [Cor Fundo Página] )
		displayFolder: 92. Páginas HTML
		lineageTag: e167b478-edb0-43ec-b26d-dc946b555ab9

	/// Barra lateral de navegação (232 × 1080). Itens marcados com %A0%…%A7% recebem a classe on por página.
	measure 'Menu Base HTML' =
			VAR __Tot = FORMAT ( CALCULATE ( [Total de Títulos], REMOVEFILTERS () ), "#,0", "pt-BR" )
			VAR __Pl = CALCULATE ( COUNTROWS ( dPlatform ), REMOVEFILTERS () )
			VAR __Pa = CALCULATE ( [Diversidade Geográfica], REMOVEFILTERS () )
			VAR __Ref = FORMAT ( [Data de Referência], "dd/mm/yyyy" )
			VAR __Svg = "<svg viewBox='0 0 24 24' width='18' height='18' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'><path d='"
			VAR __Css =
			    "<style>.sd{position:absolute;inset:0;background:linear-gradient(180deg,%CARD2% 0%,%BG% 70%);border-right:1px solid %LINE%}"
			    & ".br{position:absolute;left:22px;top:28px;display:flex;align-items:center;gap:12px}"
			    & ".lg{width:40px;height:40px;border-radius:12px;background:linear-gradient(135deg,%PRI% 0%,%ACC% 100%);display:grid;place-items:center;box-shadow:0 8px 24px %PRI%59}"
			    & ".bn{font-size:18px;font-weight:700;letter-spacing:-.02em}.bs{font-size:12px;color:%TX2%}"
			    & ".sl{position:absolute;left:30px;top:110px;font-size:12px;letter-spacing:.14em;color:%TX2%;font-weight:600}"
			    & ".it{position:absolute;left:16px;width:200px;height:44px;border-radius:12px;display:flex;align-items:center;gap:12px;padding:0 14px;color:%TX2%;font-size:14px;font-weight:500}"
			    & ".it.on{background:linear-gradient(90deg,%PRI%38 0%,%PRI%0A 100%);color:%TX%;font-weight:600;box-shadow:inset 3px 0 0 %PRI%}"
			    & ".it.on svg{color:%PRI3%}"
			    & ".st{position:absolute;left:16px;right:16px;bottom:24px;border-radius:14px;padding:16px;background:%PRI%14;border:1px solid %PRI%33}"
			    & ".st .v{font-size:22px;font-weight:700;margin-top:6px}.st .l{font-size:12px;color:%TX2%;margin-top:4px;line-height:1.5}</style>"
			VAR __CssT =
			    SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( __Css,
			        "%TX2%", [Cor Texto Suave] ), "%TX%", [Cor Texto] ), "%CARD2%", [Cor Fundo Card Elevado] ),
			        "%BG%", [Cor Fundo Página] ), "%LINE%", [Cor Trilho] ), "%PRI3%", [Cor Destaque Suave] ), "%ACC%", [Cor Acento] )
			VAR __CssF = SUBSTITUTE ( __CssT, "%PRI%", [Cor Primária] )
			VAR __Itens =
			    "<div class='it %A0%' style='top:140px'>" & __Svg & "M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z'/></svg>Início</div>"
			    & "<div class='it %A1%' style='top:192px'>" & __Svg & "M4 4h7v7H4zM13 4h7v4h-7zM13 10h7v10h-7zM4 13h7v7H4z'/></svg>Visão Executiva</div>"
			    & "<div class='it %A2%' style='top:244px'>" & __Svg & "M12 3l9 5-9 5-9-5 9-5zM3 13l9 5 9-5M3 17l9 5 9-5'/></svg>Plataformas</div>"
			    & "<div class='it %A3%' style='top:296px'>" & __Svg & "M13 2L4 14h7l-1 8 9-12h-7z'/></svg>Qualidade &amp; Eficiência</div>"
			    & "<div class='it %A4%' style='top:348px'>" & __Svg & "M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18zM3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18'/></svg>Mapa Global</div>"
			    & "<div class='it %A5%' style='top:400px'>" & __Svg & "M8 4h8v4a4 4 0 0 1-8 0zM8 6H5a3 3 0 0 0 3 4M16 6h3a3 3 0 0 1-3 4M12 12v4M9 20h6M10 16h4v4h-4z'/></svg>Prêmios &amp; Prestígio</div>"
			    & "<div class='it %A6%' style='top:452px'>" & __Svg & "M3 17l6-6 4 4 8-8M15 7h6v6'/></svg>Tendências</div>"
			    & "<div class='it %A7%' style='top:504px'>" & __Svg & "M4 5h16v14H4zM4 10h16M4 15h16M10 5v14'/></svg>Catálogo</div>"
			RETURN
			    [CSS Base HTML] & __CssF
			        & "<div class='r'><div class='sd'></div>"
			        & "<div class='br'><div class='lg'><svg viewBox='0 0 24 24' width='18' height='18'><path d='M8 5.5v13l11-6.5z' fill='#FFFFFF'/></svg></div>"
			        & "<div><div class='bn'>StreamIQ</div><div class='bs'>Catalog Intelligence</div></div></div>"
			        & "<div class='sl'>ANÁLISES</div>" & __Itens
			        & "<div class='st'><div class='ey'>Base analisada</div><div class='v nm'>" & __Tot & " títulos</div>"
			        & "<div class='l'>" & __Pl & " plataformas · " & __Pa & " países<br>Dados até " & __Ref & "</div></div></div>"
		displayFolder: 92. Páginas HTML
		lineageTag: 70685c87-8782-4774-9cf8-1e230175cf31

