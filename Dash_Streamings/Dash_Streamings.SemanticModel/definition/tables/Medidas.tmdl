table Medidas
	lineageTag: 6582b5e9-cba3-42ae-b266-d5e7d5fba05b

	/// Data mais recente de entrada de título no catálogo — referência para janelas relativas (novidade, YoY). Ignora filtros para permanecer estável.
	measure 'Data de Referência' = CALCULATE ( MAX ( fStreamingCatalog[date_added] ), REMOVEFILTERS () )
		formatString: dd/mm/yyyy
		displayFolder: 99. Técnicas
		lineageTag: 45fb0ca0-759e-4d04-9404-e87b814b2446

	/// KPI-1 · Total de títulos no catálogo (contagem de show_id).
	measure 'Total de Títulos' = COUNTROWS ( fStreamingCatalog )
		formatString: #,0
		displayFolder: 01. Volume
		lineageTag: aa1eba74-1614-452a-9253-d2c7e73a8471

	/// KPI-9 · Títulos adicionados no período filtrado (usa relacionamento ativo date_added → dCalendario).
	measure 'Títulos Adicionados' = [Total de Títulos]
		formatString: #,0
		displayFolder: 01. Volume
		lineageTag: badb373d-2ff0-46d5-aea0-6d63780c1414

	/// Títulos adicionados no mesmo período do ano anterior — base para variação YoY.
	measure 'Títulos Adicionados AA' =
			CALCULATE (
			    [Títulos Adicionados],
			    SAMEPERIODLASTYEAR ( dCalendario[Data] )
			)
		formatString: #,0
		displayFolder: 99. Técnicas
		lineageTag: b2e356f3-2e11-4dcc-b326-9a656131ef68

	/// KPI-10 · Variação percentual de títulos adicionados vs. mesmo período do ano anterior.
	measure 'Var % Títulos YoY' =
			VAR __Atual    = [Títulos Adicionados]
			VAR __Anterior = [Títulos Adicionados AA]
			RETURN
			    DIVIDE ( __Atual - __Anterior, __Anterior )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01. Volume
		lineageTag: 858eb134-aa0e-4baf-93e9-41928350d2c1

	/// KPI-15 · Fração do catálogo filtrado adicionada nos 12 meses anteriores à Data de Referência (ignora só o filtro de período).
	measure 'Índice de Novidade' =
			VAR __Ref = [Data de Referência]
			VAR __Corte = EDATE ( __Ref, -12 )
			VAR __Novos =
			    CALCULATE (
			        [Total de Títulos],
			        REMOVEFILTERS ( dCalendario ),
			        KEEPFILTERS ( fStreamingCatalog[date_added] > __Corte )
			    )
			VAR __Total = CALCULATE ( [Total de Títulos], REMOVEFILTERS ( dCalendario ) )
			RETURN
			    DIVIDE ( __Novos, __Total )
		formatString: 0.0%
		displayFolder: 01. Volume
		lineageTag: e38920b6-dad1-40ad-bd57-1e952bb0fa74

	/// KPI-14 · Quantidade de países únicos presentes no catálogo filtrado.
	measure 'Diversidade Geográfica' = DISTINCTCOUNT ( fStreamingCatalog[country] )
		formatString: #,0
		displayFolder: 01. Volume
		lineageTag: c224ea50-38f4-46da-92a7-93d186216eec

	/// KPI-2 · Nota média IMDb dos títulos filtrados (escala 0–10).
	measure 'IMDb Médio' = AVERAGE ( fStreamingCatalog[imdb_rating] )
		formatString: 0.0
		displayFolder: 02. Qualidade
		lineageTag: b4a10508-2237-41e5-b024-f3ee307c85a4

	/// KPI-3 · Nota média Rotten Tomatoes dos títulos filtrados (% 0–100).
	measure 'Rotten Tomatoes Médio' = AVERAGE ( fStreamingCatalog[rotten_tomatoes_score] )
		formatString: 0.0
		displayFolder: 02. Qualidade
		lineageTag: 0211cd0a-33d2-45cc-8bf5-9d0e993ceace

	/// KPI-11 · Idade média dos títulos em anos, calculada a partir de release_year vs. ano de referência.
	measure 'Idade Média (anos)' =
			VAR __AnoRef = YEAR ( [Data de Referência] )
			RETURN
			    AVERAGEX (
			        fStreamingCatalog,
			        __AnoRef - fStreamingCatalog[release_year]
			    )
		formatString: 0.0
		displayFolder: 02. Qualidade
		lineageTag: 151f0a3b-e999-4acb-a040-f466cb4d2658

	/// KPI-4 · Total de horas assistidas em milhões — indicador de engajamento absoluto.
	measure 'Horas Assistidas (Mi)' = SUM ( fStreamingCatalog[hours_watched_million] )
		formatString: #,0.0
		displayFolder: 03. Engajamento
		lineageTag: 5cd21da1-db12-48c1-b9e5-40ff0c673dda

	/// Média de votos IMDb por título — proxy de alcance/popularidade.
	measure 'Votos IMDb Médio' = AVERAGE ( fStreamingCatalog[imdb_votes] )
		formatString: #,0
		displayFolder: 03. Engajamento
		lineageTag: a7ac86a3-b5e2-4596-86cb-b8a1c13c6681

	/// KPI-5 · Soma do orçamento de produção em US$ milhões.
	measure 'Orçamento Total (US$ Mi)' = SUM ( fStreamingCatalog[budget_million_usd] )
		formatString: "US$ "#,0.0
		displayFolder: 04. Financeiro
		lineageTag: 17f4c62d-b060-44da-b656-5af1333f29bc

	/// Orçamento médio por título, considerando apenas títulos com orçamento > 0.
	measure 'Orçamento Médio (US$ Mi)' =
			CALCULATE (
			    AVERAGE ( fStreamingCatalog[budget_million_usd] ),
			    fStreamingCatalog[budget_million_usd] > 0
			)
		formatString: "US$ "#,0.0
		displayFolder: 04. Financeiro
		lineageTag: e7fe808b-daa4-41fc-9b16-a649485c1e67

	/// KPI-6 · Horas assistidas por dólar de orçamento. Regra R6: exclui títulos com orçamento zero.
	measure 'Horas por US$ Mi' =
			VAR __Horas =
			    CALCULATE (
			        [Horas Assistidas (Mi)],
			        fStreamingCatalog[budget_million_usd] > 0
			    )
			VAR __Orcamento = [Orçamento Total (US$ Mi)]
			RETURN
			    DIVIDE ( __Horas, __Orcamento )
		formatString: #,0.00
		displayFolder: 04. Financeiro
		lineageTag: a7e955d7-c495-4623-bc04-af29e28de987

	/// KPI-7 · Total de prêmios ganhos pelos títulos filtrados.
	measure 'Prêmios Ganhos' = SUM ( fStreamingCatalog[awards_won] )
		formatString: #,0
		displayFolder: 05. Reconhecimento
		lineageTag: c20bcf50-c2e7-470d-86aa-fab0e3029509

	/// KPI-8 · Prêmios ganhos por milhão de orçamento (eficiência de prestige content). Exclui orçamento zero.
	measure 'Prêmios por US$ Mi' =
			VAR __Premios =
			    CALCULATE (
			        [Prêmios Ganhos],
			        fStreamingCatalog[budget_million_usd] > 0
			    )
			VAR __Orcamento = [Orçamento Total (US$ Mi)]
			RETURN
			    DIVIDE ( __Premios, __Orcamento )
		formatString: 0.00
		displayFolder: 05. Reconhecimento
		lineageTag: c83da416-acb4-47f9-b900-2c501aaa2b9a

	/// KPI-12 · Duração média em minutos considerando apenas títulos do tipo Movie.
	measure 'Duração Média Filme (min)' =
			CALCULATE (
			    AVERAGE ( fStreamingCatalog[duration_minutes] ),
			    KEEPFILTERS ( dType[Tipo] = "Movie" )
			)
		formatString: #,0
		displayFolder: 06. Formato
		lineageTag: 15d42dfc-bd67-4f7b-b4b9-1a47e56ebdb7

	/// KPI-13 · Número médio de temporadas por série (tipo TV Show).
	measure 'Temporadas Médias (Série)' =
			CALCULATE (
			    AVERAGE ( fStreamingCatalog[num_seasons] ),
			    KEEPFILTERS ( dType[Tipo] = "TV Show" )
			)
		formatString: 0.0
		displayFolder: 06. Formato
		lineageTag: ad038e95-e9e8-4222-8239-9670cef8b45f

	/// Número médio de episódios por série (tipo TV Show).
	measure 'Episódios Médios (Série)' =
			CALCULATE (
			    AVERAGE ( fStreamingCatalog[num_episodes] ),
			    KEEPFILTERS ( dType[Tipo] = "TV Show" )
			)
		formatString: #,0
		displayFolder: 06. Formato
		lineageTag: bb4b509a-8f51-45a9-9392-c16309426a2d

	/// Contagem de títulos do tipo Movie.
	measure 'Total de Filmes' = CALCULATE ( [Total de Títulos], KEEPFILTERS ( dType[Tipo] = "Movie" ) )
		formatString: #,0
		displayFolder: 06. Formato
		lineageTag: 0001d22e-a790-4578-b6e5-739c9e7f6880

	/// Contagem de títulos do tipo TV Show.
	measure 'Total de Séries' = CALCULATE ( [Total de Títulos], KEEPFILTERS ( dType[Tipo] = "TV Show" ) )
		formatString: #,0
		displayFolder: 06. Formato
		lineageTag: 87b4b1ef-0166-48ad-a171-c16b82e5d90a

	/// Ranking de plataformas por Total de Títulos (1 = mais títulos).
	measure 'Ranking Plataforma (Títulos)' =
			IF (
			    HASONEVALUE ( dPlatform[Platform] ),
			    RANKX ( ALL ( dPlatform[Platform] ), [Total de Títulos],, DESC, DENSE )
			)
		formatString: 0
		displayFolder: 07. Rankings
		lineageTag: f4b41585-ce9c-4c76-a503-960119bf32ed

	/// Ranking de gêneros primários por Total de Títulos.
	measure 'Ranking Gênero (Títulos)' =
			IF (
			    HASONEVALUE ( dGenre[Genero] ),
			    RANKX ( ALL ( dGenre[Genero] ), [Total de Títulos],, DESC, DENSE )
			)
		formatString: 0
		displayFolder: 07. Rankings
		lineageTag: 46af53b6-cdba-450c-b2fe-a2cdcaa9d2e6

	/// Ranking de plataformas por Horas Assistidas.
	measure 'Ranking Plataforma (Horas)' =
			IF (
			    HASONEVALUE ( dPlatform[Platform] ),
			    RANKX ( ALL ( dPlatform[Platform] ), [Horas Assistidas (Mi)],, DESC, DENSE )
			)
		formatString: 0
		displayFolder: 07. Rankings
		lineageTag: bf97e31a-30df-4b19-ac41-70b9fe7ef687

