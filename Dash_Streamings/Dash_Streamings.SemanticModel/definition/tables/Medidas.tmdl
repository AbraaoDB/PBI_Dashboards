	/// Molde do cabeçalho de página (820 × 84): %EY% eyebrow, %T% título, %S% frase-insight.
	measure 'Cabeçalho Base HTML' =
			VAR __Ctx = SUBSTITUTE ( SUBSTITUTE ( [Contexto Recorte Texto], "&", "&amp;" ), "<", "&lt;" )
			VAR __Css =
			    "<style>.hd{height:100vh;display:flex;flex-direction:column;justify-content:center;gap:3px}"
			    & ".hl{display:flex;align-items:center;gap:10px}"
			    & ".h1{font-size:28px;font-weight:700;letter-spacing:-.025em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
			    & ".hs{font-size:13px;color:" & [Cor Texto Suave] & ";white-space:nowrap;overflow:hidden;text-overflow:ellipsis}"
			    & ".hs b{color:" & [Cor Texto] & ";font-weight:600}</style>"
			RETURN
			    [CSS Base HTML] & __Css
			        & "<div class='r hd'><div class='hl'><span class='ey' style='color:" & [Cor Destaque Suave] & "'>%EY%</span>"
			        & "<span class='chip'>" & __Ctx & "</span></div>"
			        & "<div class='h1'>%T%</div><div class='hs'>%S%</div></div>"
		displayFolder: 92. Páginas HTML
		lineageTag: 67907910-d2bf-46e0-a4e6-d866c36974d3

