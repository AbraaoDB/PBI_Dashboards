		summarizeBy: none
		sourceColumn: [Data]

	column Ano
		dataType: int64
		formatString: 0
		lineageTag: 083e14af-8eab-418d-a32c-7e0ec6499576
		summarizeBy: none
		sourceColumn: [Ano]

	column NumMes
		dataType: int64
		formatString: 0
		lineageTag: 00123978-d092-40aa-b7ff-0d59b3e6288c
		summarizeBy: none
		sourceColumn: [NumMes]

	column Mes
		dataType: string
		lineageTag: 724c6cff-834a-4680-b72a-9ec358feb380
		summarizeBy: none
		sourceColumn: [Mes]
		sortByColumn: NumMes

	column NumTrimestre
		dataType: int64
		formatString: 0
		lineageTag: 891083eb-e869-40db-be77-e77dd665d08b
		summarizeBy: none
		sourceColumn: [NumTrimestre]

