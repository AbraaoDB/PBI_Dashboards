		lineageTag: 376fed7e-f370-46fc-899b-179d881e24da
		summarizeBy: none
		sourceColumn: [Trimestre]
		sortByColumn: NumTrimestre

	column AnoMes
		dataType: int64
		formatString: 0
		lineageTag: fa9f74eb-d46a-4db6-968f-4d5c253d9302
		summarizeBy: none
		sourceColumn: [AnoMes]

	column Dia
		dataType: int64
		formatString: 0
		lineageTag: 217421b8-bf44-4eed-ac0d-0074bcf196e9
		summarizeBy: none
		sourceColumn: [Dia]

	column NumDiaSemana
		dataType: int64
		formatString: 0
		lineageTag: 019a06ab-72fa-4cca-8a73-266f38a2c67a
		summarizeBy: none
		sourceColumn: [NumDiaSemana]

	column DiaSemana
		dataType: string
		lineageTag: 59f91679-18a0-421c-a619-3168d3eb2acf
		summarizeBy: none
		sourceColumn: [DiaSemana]
		sortByColumn: NumDiaSemana

	partition dCalendario = calculated
		mode: import
		source =
				SELECTCOLUMNS(
				    ADDCOLUMNS(
				        CALENDAR( DATE(1980,1,1), DATE(2026,12,31) ),
				        "@Ano",          YEAR([Date]),
				        "@NumMes",       MONTH([Date]),
				        "@Mes",          FORMAT([Date], "mmm"),
				        "@NumTrimestre", QUARTER([Date]),
				        "@Trimestre",    "T" & QUARTER([Date]),
				        "@AnoMes",       YEAR([Date]) * 100 + MONTH([Date]),
				        "@Dia",          DAY([Date]),
				        "@NumDiaSemana", WEEKDAY([Date], 2),
				        "@DiaSemana",    FORMAT([Date], "ddd")
				    ),
				    "Data",         [Date],
				    "Ano",          [@Ano],
				    "NumMes",       [@NumMes],
				    "Mes",          [@Mes],
				    "NumTrimestre", [@NumTrimestre],
				    "Trimestre",    [@Trimestre],
				    "AnoMes",       [@AnoMes],
				    "Dia",          [@Dia],
				    "NumDiaSemana", [@NumDiaSemana],
				    "DiaSemana",    [@DiaSemana]
				)

