{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.153.json",
  "name": "StreamIQ-Dark.json",
  "dataColors": [
    "#8B5CF6",
    "#22D3EE",
    "#F472B6",
    "#34D399",
    "#FBBF24",
    "#E50914",
    "#00A8E1",
    "#4F7CFF",
    "#1CE783",
    "#A259FF",
    "#2DD4BF",
    "#D4D4DC",
    "#FACC15",
    "#EC4899",
    "#FF7A1A"
  ],
  "background": "#07070D",
  "foreground": "#F4F4F8",
  "tableAccent": "#8B5CF6",
  "good": "#34D399",
  "neutral": "#FBBF24",
  "bad": "#F87171",
  "maximum": "#8B5CF6",
  "center": "#4C1D95",
  "minimum": "#1A1A2E",
  "null": "#262638",
  "firstLevelElements": "#F4F4F8",
  "secondLevelElements": "#A1A1B5",
  "thirdLevelElements": "#262638",
  "fourthLevelElements": "#5B5B72",
  "secondaryBackground": "#11111C",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#F4F4F8"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#F4F4F8"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#A1A1B5"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#A1A1B5"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#F4F4F8"
              }
            },
            "background": {
              "solid": {
                "color": "#1A1A2E"
              }
            }
          }
        ],
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#A1A1B5"
              }
            }
          }
        ]
      }
    }
  }
}